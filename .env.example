# Docker Compose local configuration
WEB_PORT=3000
PORT=3000
HOSTNAME=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false
NEXT_PUBLIC_APP_NAME='CV Builder'
NEXT_PUBLIC_API_URL=http://localhost:3001/api
REDIS_DB=0
WORKER_CONCURRENCY=1
WORKER_NAME=cv-builder-worker
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_STOP_GRACE_PERIOD=35s

# PostgreSQL local development only. Replace the example password outside local use.
POSTGRES_DB=cv_builder
POSTGRES_USER=cv_builder
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Prisma commands run on the host. Percent-encode special URL characters in credentials.
DATABASE_URL='postgresql://cv_builder:replace-with-a-local-development-password@127.0.0.1:5432/cv_builder'

# Opt-in integration tests must use a distinct, isolated database and never fall back to DATABASE_URL.
TEST_DATABASE_URL='postgresql://cv_builder:replace-with-a-local-development-password@127.0.0.1:5432/cv_builder_test'
RUN_DATABASE_INTEGRATION_TESTS=false

# Direct API development
NODE_ENV=development
API_HOST=0.0.0.0

# Direct worker development
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
