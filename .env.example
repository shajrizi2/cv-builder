# Docker Compose local configuration
WEB_PORT=3000
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false
REDIS_DB=0
WORKER_CONCURRENCY=1
WORKER_NAME=cv-builder-worker
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_STOP_GRACE_PERIOD=35s

# Direct API development
NODE_ENV=development
API_HOST=0.0.0.0

# Direct worker development
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
