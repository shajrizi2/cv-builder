# Docker Compose local configuration
WEB_PORT=3000
PORT=3000
HOSTNAME=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false
NEXT_PUBLIC_APP_NAME='CV Builder'
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Server-only Better Auth configuration. Generate a unique high-entropy secret
# for every production environment; never prefix these values with NEXT_PUBLIC_.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# The issuer is the public Better Auth origin encoded into API JWTs. The API
# container reaches JWKS internally through AUTH_JWKS_URL in Compose.
API_JWT_ISSUER=http://localhost:3000
API_JWT_AUDIENCE=cv-builder-api
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
REDIS_DB=0
WORKER_CONCURRENCY=1
WORKER_NAME=cv-builder-worker
WORKER_SHUTDOWN_TIMEOUT_MS=30000
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
WORKER_STOP_GRACE_PERIOD=35s

# PostgreSQL local development only. Replace the example password outside local use.
POSTGRES_DB=cv_builder
POSTGRES_USER=cv_builder
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Prisma commands run on the host. Percent-encode special URL characters in credentials.
DATABASE_URL='postgresql://cv_builder:replace-with-a-local-development-password@127.0.0.1:5432/cv_builder'

# Opt-in integration tests must use a distinct, isolated database and never fall back to DATABASE_URL.
TEST_DATABASE_URL='postgresql://cv_builder:replace-with-a-local-development-password@127.0.0.1:5432/cv_builder_test'
RUN_DATABASE_INTEGRATION_TESTS=false
RUN_MINIO_INTEGRATION_TESTS=false

# Direct API development
NODE_ENV=development
API_HOST=0.0.0.0

# Direct worker development
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Private CV import storage and AI worker. Use non-example secrets outside local development.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=cv-builder-minio
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_ACCESS_KEY=cv-builder-minio
MINIO_SECRET_KEY=replace-with-a-local-minio-password
MINIO_BUCKET=cv-imports
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
