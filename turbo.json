{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:integration": {
      "cache": false,
      "env": ["RUN_DATABASE_INTEGRATION_TESTS", "RUN_WORKER_INTEGRATION_TESTS", "TEST_DATABASE_URL"]
    }
  }
}
